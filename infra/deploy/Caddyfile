chapchap.kr {
    handle_path /api/* {
        request_header X-Forwarded-Prefix /api
        import upstream.caddy
    }

    handle {
        # 프론트 배포 스크립트가 releases/<sha> + current 심볼릭 링크 구조로 배포하므로
        # /srv/frontend가 아니라 그 심볼릭 링크(current)를 docroot로 잡아야 함
        root * /srv/frontend/current
        try_files {path} /index.html
        file_server
    }

    encode gzip

    # stdout으로 출력 Docker awslogs 드라이버가 잡아서 CloudWatch로 전송
    log {
        format filter {
            request>uri query {
                replace code REDACTED
                replace state REDACTED
            }
            resp_headers>Location delete
            wrap json
        }
    }
}
