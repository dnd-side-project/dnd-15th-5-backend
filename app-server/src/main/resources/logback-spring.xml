<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n%ex{10}</pattern>
        </encoder>
    </appender>

    <springProfile name="prod">
        <appender name="DISCORD" class="kr.chapchap.core.logging.DiscordWebhookAppender">
            <webhookUrl>${DISCORD_ALERT_WEBHOOK_URL:-}</webhookUrl>
            <environment>${SPRING_PROFILES_ACTIVE:-unknown}</environment>
            <applicationName>👾ChapChap Backend</applicationName>
            <dedupeWindowSeconds>1200</dedupeWindowSeconds>
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>ERROR</level>
            </filter>
        </appender>
    </springProfile>

    <root level="info">
        <appender-ref ref="STDOUT"/>
    </root>

    <springProfile name="prod">
        <logger name="kr.chapchap.core.web.exception.GlobalExceptionHandler" additivity="false">
            <appender-ref ref="STDOUT"/>
            <appender-ref ref="DISCORD"/>
        </logger>
        <logger name="kr.chapchap.report.application.service.MonthlyReportAggregationService" additivity="false">
            <appender-ref ref="STDOUT"/>
            <appender-ref ref="DISCORD"/>
        </logger>
    </springProfile>

    <springProfile name="local">
        <logger name="kr.chapchap" level="debug" additivity="false">
            <appender-ref ref="STDOUT"/>
        </logger>

        <logger name="org.hibernate.SQL" level="debug"/>
        <logger name="org.springframework.web.filter.CommonsRequestLoggingFilter" level="debug"/>

        <logger name="org.springframework" level="info"/>
        <logger name="org.springframework.security" level="warn"/>
        <logger name="org.hibernate.validator" level="warn"/>
        <logger name="org.apache.tomcat" level="warn"/>
        <logger name="org.apache.catalina" level="warn"/>
        <logger name="org.apache.coyote" level="warn"/>
        <logger name="sun.rmi" level="warn"/>
        <logger name="io.micrometer" level="warn"/>
        <logger name="org.springdoc" level="warn"/>
    </springProfile>

    <springProfile name="prod">
        <logger name="org.hibernate" level="warn"/>
        <logger name="org.springframework.security" level="warn"/>
    </springProfile>

</configuration>
