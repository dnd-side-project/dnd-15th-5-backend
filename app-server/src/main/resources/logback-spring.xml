<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n%ex{10}</pattern>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="STDOUT"/>
    </root>

    <springProfile name="local">
        <logger name="kr.chapchap" level="debug" additivity="false">
            <appender-ref ref="STDOUT"/>
        </logger>

        <logger name="org.hibernate.SQL" level="debug"/>
        <logger name="org.springframework.web.filter.CommonsRequestLoggingFilter" level="debug"/>

        <logger name="org.springframework" level="info"/>
        <logger name="org.springframework.security" level="warn"/>
        <logger name="org.hibernate.validator" level="warn"/>
        <logger name="org.apache.tomcat" level="warn"/>
        <logger name="org.apache.catalina" level="warn"/>
        <logger name="org.apache.coyote" level="warn"/>
        <logger name="sun.rmi" level="warn"/>
        <logger name="io.micrometer" level="warn"/>
        <logger name="org.springdoc" level="warn"/>
    </springProfile>

    <springProfile name="prod">
        <logger name="org.hibernate" level="warn"/>
        <logger name="org.springframework.security" level="warn"/>
    </springProfile>

</configuration>
